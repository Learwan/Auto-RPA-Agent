AUTO_AGENT_DATA_DIR=data
AUTO_AGENT_DB_URL=sqlite+aiosqlite:///data/auto_agent.db

AUTO_AGENT_CORS_ALLOW_ORIGINS=*
AUTO_AGENT_CORS_ALLOW_CREDENTIALS=false

AUTO_AGENT_RECORD_ENABLE_MOUSE=true
AUTO_AGENT_RECORD_ENABLE_KEYBOARD=true
AUTO_AGENT_RECORD_ENABLE_WINDOW=true
AUTO_AGENT_RECORD_ENABLE_CLIPBOARD=true
AUTO_AGENT_WEB_BROWSER=chromium
AUTO_AGENT_WEB_HEADLESS=true
AUTO_AGENT_WEB_TIMEOUT_MS=10000
AUTO_AGENT_WEB_VIEWPORT_WIDTH=1440
AUTO_AGENT_WEB_VIEWPORT_HEIGHT=900
AUTO_AGENT_RECORD_ENABLE_FILESYSTEM=false
AUTO_AGENT_RECORD_FILESYSTEM_PATHS=

AUTO_AGENT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
AUTO_AGENT_LLM_API_KEY=
AUTO_AGENT_LLM_MODEL=minimaxai/minimax-m2.7
AUTO_AGENT_LLM_MAX_TOKENS=16384
LLM_TOP_P=0.95
LLM_MAX_TOKENS=16384
